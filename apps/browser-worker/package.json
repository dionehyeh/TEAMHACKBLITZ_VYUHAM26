{
  "name": "@bizcontext/browser-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated Playwright execution worker for browser-capable AI agents (IMPLEMENTATION.md Section 5).",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "lint": "tsc --noEmit",
    "setup": "bunx playwright install chromium",
    "test": "bun test"
  },
  "dependencies": {
    "playwright": "^1.50.0",
    "bullmq": "^5.41.0",
    "hono": "^4.7.1",
    "ioredis": "^5.5.0",
    "zod": "^3.24.2",
    "@bizcontext/types": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
